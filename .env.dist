# Rewards Collector Python Environment Configuration

# Beaconcha.in API
# Only required for the legacy 'beaconchain' data source or as a migration fallback.
API_KEY=

# Ethereum RPC
RPC_URL=http://localhost:8545

# --- Local-node rewards migration (replaces Beaconcha.in) ---
# Primary reward data source: 'local' (Lighthouse + Nethermind + MEV relays)
# or 'beaconchain' (legacy API).
DATA_SOURCE=local
# Lighthouse beacon node (consensus layer) base URL.
BEACON_NODE_URL=http://localhost:5052
# Execution node JSON-RPC for producer-reward calc (defaults to RPC_URL if unset).
EXECUTION_RPC_URL=
# When DATA_SOURCE=local, fall back to Beaconcha.in if a local query fails
# (requires API_KEY). Set to 'false' once the migration is validated.
BEACONCHAIN_FALLBACK=true

# Discord Bot (for bot.py and cdp_monitor.py)
DISCORD_BOT_TOKEN=
CDP_ALERT_CHANNEL_ID=

# Discord Webhooks (for notifications)
DISCORD_WEBHOOK_URL=

# OpenAI (for AI features)
OPENAI_API_KEY=

# CDP Monitoring
CDP_POSITION_ADDRESS=
CDP_HEALTH_THRESHOLD=1.5

# Rewards Collection
VALIDATOR_CSV=../data/validators_updated.csv
OUTPUT_DIR=./rewards_data
DATA_DIR=./
EPOCH_START=198903
EPOCH_INTERVAL=100
CHECK_INTERVAL=60
BACKFILL_DELAY=15
# Continuous monitor (rewards_continuous_monitor.py): explicit start epoch for a
# fresh deploy with no state file and no existing parquet. Leave blank to begin
# live at the current finalized epoch (use backfill.py for deep history).
MONITOR_START_EPOCH=

# Environment
DEBUG=false
ENV=production
